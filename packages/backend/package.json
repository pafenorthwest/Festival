{
	"name": "@festival/backend",
	"version": "0.3.0",
	"main": "./dist/index.js",
	"dependencies": {
		"@festival/common": "workspace:*",
		"firebase-admin": "^13.6.0",
		"hono": "^4.12.9"
	},
	"private": true,
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"lint": "tsc -p tsconfig.json --noEmit",
		"build": "tsc -p tsconfig.build.json && bun build ./scripts/reap-class-checkout-executions.ts ./scripts/reap-class-checkout-recovery.ts ./scripts/reconcile-firebase-claims.ts ./scripts/reconcile-shopify-orders.ts --target=bun --outdir ./dist/scripts --packages=external",
		"reap:class-checkout": "bun ./dist/scripts/reap-class-checkout-executions.js",
		"test": "bun test",
		"seed:test-data": "bun run scripts/load-test-data.ts",
		"perf:children": "bun run ./scripts/perf-500-children.ts",
		"perf:scenarios": "bun run ./scripts/perf-advanced-scenarios.ts"
	},
	"type": "module"
}

# Copy to cloud-setup/.env, replace every REPLACE_WITH value, then chmod 600.
# Keep every value on one line. FIREBASE_PRIVATE_KEY uses literal \n separators.
# DB_PASSWORD should be at least 20 characters; hex/base64url characters work well.
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

# Firebase Admin service account and matching Firebase web application.
FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=REPLACE_WITH_SERVICE_ACCOUNT_EMAIL
FIREBASE_PRIVATE_KEY=REPLACE_WITH_ESCAPED_PRIVATE_KEY
FRONT_FIREBASE_API_KEY=REPLACE_WITH_WEB_API_KEY
FRONT_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_AUTH_DOMAIN
FRONT_FIREBASE_PROJECT_ID=REPLACE_WITH_SAME_FIREBASE_PROJECT_ID
FRONT_FIREBASE_APP_ID=REPLACE_WITH_WEB_APP_ID

# Optional: configure a keyring to enable Shopify integrations.
# Generate a 32-byte key, encode it as canonical base64, then set both values.
# FESTIVAL_SECRET_KEYS_JSON={"key-1":"REPLACE_WITH_BASE64_KEY"}
# FESTIVAL_ACTIVE_SECRET_KEY_ID=key-1
# Set an external HTTPS origin before using Shopify webhook/customer callbacks.
# FESTIVAL_PUBLIC_ORIGIN=https://festival.example.com

# Production deployment settings. Frontend API calls stay on the same origin.
# API_ALLOWED_ORIGINS=https://festival.example.com
TRUST_PROXY_HEADERS=true
FESTIVAL_RECONCILIATION_TOKEN=REPLACE_WITH_DISTINCT_LONG_RANDOM_TOKEN
# ENABLE_DROP_TRANSFER=false
